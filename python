    users = [
        (f"py_user_{i}", f"py_user_{i}@mail.com", "hash", 2)
        for i in range(1, n + 1)
    ]

    cursor.executemany(
        "INSERT INTO users(username,email,password_hash,role_id) VALUES (%s,%s,%s,%s)",
        users
    )

    db.commit()
    db.close()

