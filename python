def top_users(min_spent=100):
    db = get_connection()
    query = """
    SELECT *
    FROM v_top_users
    WHERE spent > %s
    ORDER BY spent DESC
    LIMIT 10
    """
    df = pd.read_sql(query, db, params=(min_spent,))
    db.close()
    return df


